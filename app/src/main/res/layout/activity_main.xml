<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RC29 Toolbox" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/accent" android:padding="16dp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/nav_overview" style="@style/Nav" android:text="Overview" />
            <Button android:id="@+id/nav_setup" style="@style/Nav" android:text="Developer setup" />
            <Button android:id="@+id/nav_catalog" style="@style/Nav" android:text="App installs" />
            <Button android:id="@+id/nav_play" style="@style/Nav" android:text="Play Store" />
            <Button android:id="@+id/nav_help" style="@style/Nav" android:text="Help &amp; report" />
        </LinearLayout>
    </HorizontalScrollView>
    <ProgressBar android:id="@+id/busy" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="invisible" />
    <ScrollView android:id="@+id/content_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <FrameLayout android:id="@+id/page" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" />
    </ScrollView>
</LinearLayout>
